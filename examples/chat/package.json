    "@effect/sql-pg": "4.0.0-beta.99",
    "@effect/sql-sqlite-node": "4.0.0-beta.99",
    "@effect/sql-sqlite-wasm": "4.0.0-beta.99",
    "@effect/wa-sqlite": "0.1.2",
    "@lucas-barake/effect-local": "workspace:^",
    "@lucas-barake/effect-local-browser": "workspace:^",
    "@lucas-barake/effect-local-rpc": "workspace:^",
