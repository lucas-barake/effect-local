{
  "name": "@effect-local/example-chat",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Local-first WhatsApp-style chat example: multi-tab browser replicas over OPFS SQLite, WebSocket sync with auth, ephemeral typing and presence, durable delivery and read receipts",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "pnpm -C server dev",
    "dev:client": "pnpm -C client dev",
    "build": "pnpm -C client build",
    "check": "tsc -b tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@effect-local/example-chat-client": "workspace:^",
    "@effect-local/example-chat-server": "workspace:^",
    "@effect-local/example-chat-shared": "workspace:^",
    "@effect/platform-node": "4.0.0-beta.103",
    "@effect/sql-sqlite-node": "4.0.0-beta.103",
    "@lucas-barake/effect-local": "workspace:^",
    "@lucas-barake/effect-local-browser": "workspace:^",
    "@lucas-barake/effect-local-rpc": "workspace:^",
    "@lucas-barake/effect-local-sql": "workspace:^",
    "effect": "4.0.0-beta.103"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-beta.103",
    "@types/node": "^25.7.0",
    "vitest": "4.1.10"
  }
}
