{
  "$schema": "http://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "include": ["bench/**/*.ts", "src/**/*.ts", "test/**/*.ts", "vitest.config.ts"],
  "compilerOptions": {
    "rootDir": ".",
    "lib": ["ES2023", "DOM"],
    "noEmit": true,
    "erasableSyntaxOnly": false,
    "types": ["node"]
  }
}
