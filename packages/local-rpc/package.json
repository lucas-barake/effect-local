{
  "name": "@lucas-barake/effect-local-rpc",
  "version": "0.0.0",
  "description": "Effect RPC peer synchronization for Effect Local",
  "homepage": "https://github.com/lucas-barake/effect-local#readme",
  "bugs": "https://github.com/lucas-barake/effect-local/issues",
  "keywords": [
    "effect",
    "local-first",
    "rpc",
    "websocket",
    "automerge"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "type": "module",
  "license": "MIT",
  "sideEffects": [],
  "repository": {
    "type": "git",
    "url": "https://github.com/lucas-barake/effect-local.git",
    "directory": "packages/local-rpc"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./internal/*": null
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      "./package.json": "./package.json",
      ".": "./dist/index.js",
      "./*": "./dist/*.js",
      "./internal/*": null
    }
  },
  "files": [
    "README.md",
    "LICENSE",
    "src/**/*.ts",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map"
  ],
  "scripts": {
    "build": "tsgo -b tsconfig.json",
    "build:tsc": "tsc -b tsconfig.json",
    "check": "tsgo -b tsconfig.json",
    "test": "vitest --config vitest.config.ts"
  },
  "dependencies": {
    "@lucas-barake/effect-local": "workspace:^",
    "@lucas-barake/effect-local-sql": "workspace:^"
  },
  "peerDependencies": {
    "effect": ">=4.0.0-beta.101 <4.0.1"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0-beta.101",
    "@effect/sql-mysql2": "4.0.0-beta.101",
    "@effect/sql-pg": "4.0.0-beta.101",
    "@effect/sql-sqlite-node": "4.0.0-beta.101",
    "@lucas-barake/effect-local-test": "workspace:^",
    "@testcontainers/mysql": "11.14.0",
    "@testcontainers/postgresql": "11.14.0",
    "effect": "4.0.0-beta.101"
  }
}
