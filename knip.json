{
  "$schema": "https://unpkg.com/knip@6.27.0/schema.json",
  "includeEntryExports": false,
  "ignore": [".worktrees/**"],
  "workspaces": {
    "packages/local-sql": {
      "entry": ["test/crash-durability/childProcess.ts", "examples/*.ts"],
      "ignoreDependencies": ["tsx"]
    },
    "packages/local-browser": {
      "entry": [
        "test-browser/*/src/*.{ts,tsx}",
        "test-browser/*/tests/*.spec.ts",
        "test-browser/*/vite.config.ts",
        "test-browser/*/public/service-worker.js",
        "test-browser/*/relay-server.ts"
      ],
      "ignoreDependencies": ["@effect/platform-browser", "tsx"]
    },
    "packages/local-test": {
      "ignoreDependencies": ["@effect/platform-node-shared"]
    },
    "examples/chat": {
      "entry": ["server/reset-test-db.ts"]
    },
    "packages/local-react-native": {
      "entry": ["test/helpers/*.ts"]
    },
    "examples/react-native-tasks": {
      "entry": ["index.ts", "app.json", "metro.config.js", "babel.config.js", "src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["babel-preset-expo", "expo-updates", "expo-system-ui"]
    }
  }
}
