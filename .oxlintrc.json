{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "oxc", "eslint", "unicorn", "node"],
  "jsPlugins": ["oxlint-plugin-effect/plugin", "./scripts/oxlint-plugin.mjs"],
  "options": {
    "typeAware": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "ignorePatterns": ["**/dist", "**/build", "**/coverage", "**/.tsbuildinfo"],
  "rules": {
    "typescript/consistent-type-imports": ["error", { "fixStyle": "inline-type-imports" }],
    "typescript/no-import-type-side-effects": "error",
    "import/no-duplicates": "error",
    "import/no-self-import": "error",
    "import/no-unassigned-import": "off",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "eslint/no-console": "error",
    "eslint/no-var": "error",
    "typescript/no-explicit-any": "off",
    "typescript/ban-ts-comment": "off",
    "typescript/no-namespace": "off",
    "typescript/no-non-null-assertion": "off",
    "eslint/no-unused-vars": "off",
    "eslint/require-yield": "off",
    "eslint/no-underscore-dangle": "off",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/require-post-message-target-origin": "off",
    "unicorn/no-empty-file": "off",
    "effect/noAs": "error",
    "effect/noAsyncFunction": "error",
    "effect/noDynamicImports": "error",
    "effect/noEffectBind": "error",
    "effect/noEffectDo": "error",
    "effect/noGlobals": "error",
    "effect/noNewError": "error",
    "effect/noNewPromise": "error",
    "effect/noNodeBuiltinImport": "error",
    "effect/noTernary": "error",
    "effect/noTestLifecycleHooks": "error",
    "effect/noThrowStatement": "error",
    "effect/noTryCatch": "error",
    "effect-local/noYieldEffectSync": "error",
    "effect-local/noSemaphoreEffectSync": "error",
    "effect-local/noNestedCalls": "error",
    "effect-local/noJsonParseStringify": "error",
    "effect-local/noUnnecessaryEffectForwarding": "error",
    "effect-local/noFunctionEffectGen": "error",
    "effect-local/noImplicitDefectConversion": "error",
    "effect-local/noExportedSchemaCodecAlias": "error",
    "effect-local/noDetachedFork": "error",
    "effect-local/noInternalEntrypointExport": "error",
    "effect-local/noTestWallClockWait": "error",
    "effect-local/noManualEffectBoundary": "error",
    "effect-local/noBareSqlRowType": "error",
    "effect-local/noEffectSyncReturningEffect": "error",
    "effect-local/effectTestsUseEffect": "error",
    "effect-local/requireSchemaTaggedError": "error",
    "effect-local/noInstanceofTaggedError": "error",
    "effect-local/noClassInstanceFactory": "error",
    "effect-local/durationInputAtConfigBoundary": "error",
    "effect-local/noModuleErrorHelper": "error",
    "effect-local/requireTaggedEffectError": "error",
    "effect-local/noUnknownEffectChannels": "error",
    "effect-local/requireLayerName": "error",
    "effect-local/noServiceTagMap": "error"
  },
  "overrides": [
    {
      "files": ["scripts/**"],
      "rules": {
        "effect/noAsyncFunction": "off",
        "effect/noGlobals": "off",
        "effect/noNewError": "off",
        "effect/noNewPromise": "off",
        "effect/noNodeBuiltinImport": "off",
        "effect/noThrowStatement": "off",
        "effect/noTryCatch": "off"
      }
    },
    {
      "files": ["**/test/**", "**/tests/**", "**/test-browser/**"],
      "rules": { "eslint/no-console": "off" }
    },
    {
      "files": ["packages/local-browser/test-browser/durability/**"],
      "rules": {
        "oxc/no-async-endpoint-handlers": "off",
        "unicorn/prefer-add-event-listener": "off"
      }
    }
  ]
}
